# Supabase (Project Settings → API). Si conectas Supabase desde el Vercel Marketplace se llenan solas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Health API (Fitbit) — Google Cloud Console → Credentials → OAuth client (Web)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# URL pública (para el redirect de OAuth). Ej: https://project-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Protege /api/cron/sync (Vercel lo manda solo como Bearer)
CRON_SECRET=
